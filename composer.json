{
    "name": "andikaryanto/laravelcommon",
    "description": "Contains common class that can be used in Ci4 dependency injection of symfony",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/testing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0",
        "midtrans/midtrans-php": "^2.6",
        "spatie/laravel-multitenancy": "^3.0|^4.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Andik Aryanto",
            "email": "andik.aryantoo@gmail.com"
        }
    ],
    "autoload": {
		"psr-4": {
			"LaravelCommon\\": "src/"
		}
	},
    "extra": {
        "laravel": {
            "dont-discover": [],
            "providers": [
                "LaravelCommon\\App\\Providers\\CommonAppServiceProvider"
            ],
            "aliases": {
                "LaraveCommon": "LaravelCommon\\System\\Support\\Facades\\Common"
            }
        }
    }
}
